{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imsg-relay-docs",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "previews.imessage-relay.luxass.dev",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true
    },
    {
      "pattern": "imessage-relay.luxass.dev",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ]
}
