---
import type { SchemaView } from '../lib/openapi';

interface Props {
  schema: SchemaView;
  /** Field cards show the type in their header and keep validation rules collapsed. */
  compact?: boolean;
}

const { schema, compact = false } = Astro.props;
const hasMetadata = schema.reference || (!compact && schema.type) || schema.constant || schema.defaultValue;
---

<div class="min-w-0 space-y-3 text-sm wrap-anywhere">
  {schema.kind === 'any' && <p>Any value is accepted.</p>}
  {schema.kind === 'never' && <p>No value is accepted.</p>}
  {
    schema.kind === 'truncated' && (
      <a class="text-(--sl-color-text-accent) underline underline-offset-4" href="/openapi.json">
        Read the full nested definition in OpenAPI JSON.
      </a>
    )
  }
  {
    schema.kind === 'schema' && (
      <>
        {hasMetadata && (
          <div class="flex flex-wrap items-baseline gap-2">
            {schema.reference && (
              <a
                href={`/api/schemas/#${schema.reference.anchor}`}
                class="rounded border border-(--sl-color-gray-5) bg-(--sl-color-gray-6) px-2 py-1 font-mono text-xs text-(--sl-color-text-accent) no-underline hover:underline"
              >
                {schema.reference.name} <span aria-hidden="true">↗</span>
              </a>
            )}
            {!compact && schema.type && (
              <code class="font-mono text-xs text-(--sl-color-gray-3)">{schema.type}</code>
            )}
            {schema.constant && (
              <span class="text-xs">Value: <code class="font-mono">{schema.constant}</code></span>
            )}
            {schema.defaultValue && (
              <span class="text-xs text-(--sl-color-gray-3)">
                Default: <code class="font-mono">{schema.defaultValue}</code>
              </span>
            )}
          </div>
        )}

        {schema.description && <p class="leading-relaxed">{schema.description}</p>}

        {schema.values.length > 0 && (
          <div class="flex flex-wrap items-baseline gap-2 text-xs">
            <span class="text-(--sl-color-gray-3)">Allowed:</span>
            {schema.values.map((value) => (
              <code class="rounded bg-(--sl-color-gray-6) px-1.5 py-0.5 font-mono">{value}</code>
            ))}
          </div>
        )}

        {schema.constraints.length > 0 && (
          <details class="border-t border-(--sl-color-gray-5) pt-3" open={!compact}>
            <summary class="cursor-pointer text-xs font-medium text-(--sl-color-gray-3)">
              Validation rules
            </summary>
            <dl class="mt-3 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-xs">
              {schema.constraints.map(({ label, value }) => (
                <>
                  <dt class="text-(--sl-color-gray-3)">{label}</dt>
                  <dd class="m-0 min-w-0 font-mono wrap-anywhere">{value}</dd>
                </>
              ))}
            </dl>
          </details>
        )}

        {schema.properties.length > 0 && (
          <dl class="divide-y divide-(--sl-color-gray-5) rounded-lg border border-(--sl-color-gray-5)">
            {schema.properties.map((field) => (
              <div class="space-y-2 px-4 py-3">
                <dt class="flex flex-wrap items-baseline gap-3">
                  <code class="font-mono font-semibold text-(--sl-color-white)">{field.name}</code>
                  <span class:list={[
                    'ms-auto text-xs',
                    field.required ? 'text-(--sl-color-text-accent)' : 'text-(--sl-color-gray-3)',
                  ]}>
                    {field.required ? 'Required' : 'Optional'}
                  </span>
                </dt>
                <dd class="m-0 min-w-0">
                  <Astro.self schema={field.schema} />
                </dd>
              </div>
            ))}
          </dl>
        )}

        {schema.closed && <p class="text-xs text-(--sl-color-gray-3)">Other fields are not accepted.</p>}

        {schema.sections.map((section) => (
          <details class="rounded-lg border border-(--sl-color-gray-5)" open={section.schemas.length === 1}>
            <summary class="cursor-pointer px-4 py-2.5 text-xs font-medium text-(--sl-color-white)">
              {section.label}
              {section.schemas.length > 1 && (
                <span class="ms-2 font-normal text-(--sl-color-gray-3)">{section.schemas.length} variants</span>
              )}
            </summary>
            <div class="space-y-4 border-t border-(--sl-color-gray-5) p-4">
              {section.schemas.map((child) => <Astro.self schema={child} />)}
            </div>
          </details>
        ))}

        {schema.examples && (
          <details class="rounded-lg border border-(--sl-color-gray-5)">
            <summary class="cursor-pointer px-4 py-2.5 text-xs font-medium">Examples</summary>
            <pre class="overflow-x-auto border-t border-(--sl-color-gray-5) p-4 text-xs"><code>{schema.examples}</code></pre>
          </details>
        )}
      </>
    )
  }
</div>
